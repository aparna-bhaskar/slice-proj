From e1d748926cc2f9d3ad87f6b48ca89a4e66936cc0 Mon Sep 17 00:00:00 2001
From: aparna-bhaskar <aparna_bhaskar@berkeley.edu>
Date: Fri, 11 Sep 2026 16:43:23 -0700
Subject: [PATCH] add Muon RV32 toolchain configuration

---
 llvm/llvm-src                     |  2 +-
 llvm/riscv32-muon-toolchain.cmake | 22 ++++++++++++++++++++++
 2 files changed, 23 insertions(+), 1 deletion(-)
 create mode 100644 llvm/riscv32-muon-toolchain.cmake

diff --git a/llvm/llvm-src b/llvm/llvm-src
index f8573da..20c0531 160000
--- a/llvm/llvm-src
+++ b/llvm/llvm-src
@@ -1 +1 @@
-Subproject commit f8573da7cbd7e76c6e46847d4afa852eaab4f7e0
+Subproject commit 20c0531c9d5ff742ac85371f83e9ef6d5cf3e126
diff --git a/llvm/riscv32-muon-toolchain.cmake b/llvm/riscv32-muon-toolchain.cmake
new file mode 100644
index 0000000..2366668
--- /dev/null
+++ b/llvm/riscv32-muon-toolchain.cmake
@@ -0,0 +1,22 @@
+set(CMAKE_SYSTEM_NAME Generic)
+set(CMAKE_SYSTEM_PROCESSOR riscv32)
+
+set(CMAKE_C_COMPILER_TARGET   riscv32-unknown-elf)
+set(CMAKE_CXX_COMPILER_TARGET riscv32-unknown-elf)
+set(CMAKE_ASM_COMPILER_TARGET riscv32-unknown-elf)
+
+set(CMAKE_SYSROOT "$ENV{HOME}/riscv32-ilp32/riscv32-unknown-elf")
+
+set(CMAKE_C_FLAGS_INIT   "-march=rv32im_zfinx_zhinx")
+set(CMAKE_CXX_FLAGS_INIT "-march=rv32im_zfinx_zhinx")
+set(CMAKE_ASM_FLAGS_INIT "-march=rv32im_zfinx_zhinx")
+
+# Bare-metal target, no OS: compiling+archiving is a valid sanity check,
+# there's no crt0/_start to link a real executable against yet.
+set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
+
+# Toolchain files load before CMakeDetermineCCompiler/CMakeTestCCompiler
+# run, so these actually stick — unlike -D flags on the command line.
+set(CMAKE_C_COMPILER_WORKS   TRUE)
+set(CMAKE_CXX_COMPILER_WORKS TRUE)
+set(CMAKE_ASM_COMPILER_WORKS TRUE)
-- 
2.45.0

